# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
# Leave empty for local sqlite (dev only); compose sets the postgres URL.
DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop
SITE_URL=http://localhost:5173

# --- Firebase auth (Google + email/password). Project id of the Firebase project; web config goes in frontend/.env.local ---
FIREBASE_PROJECT_ID=
# true = the old email+password endpoints stay on (dev / seeded demo users). Production: false.
LOCAL_PASSWORD_AUTH=true
# Production database: Neon, e.g. postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require  (use the DIRECT host, not -pooler)

# --- Odoo (external XML-RPC API) ---
ODOO_ENABLED=true
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_sub
ODOO_USER=admin
ODOO_PASSWORD=admin
# ODOO_API_KEY=            # use instead of ODOO_PASSWORD if you create a key

# --- Email ---
# console backend that survives Windows' cp1252 stdout (the rupee sign); use django.core.mail.backends.smtp.EmailBackend for real mail
EMAIL_BACKEND=apps.finance.notifications.email_backend.ConsoleEmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Brightloop <noreply@brightloop.local>

# --- WhatsApp (console | twilio | meta) ---
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v20.0

# --- Payments ---
PAYMENT_MAX_ATTEMPTS=3

# --- Reminders ---
NOTIFY_DUE_SOON_DAYS=3
NOTIFY_OVERDUE_DAYS=1,7
NOTIFY_EXPIRING_DAYS=7

# --- docker compose only ---
POSTGRES_PASSWORD=brightloop

# Signup codes for staff/admin accounts created on the signup page (empty = that account type is disabled)
STAFF_SIGNUP_CODE=
ADMIN_SIGNUP_CODE=
