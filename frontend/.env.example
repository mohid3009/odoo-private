# Copy to frontend/.env.local (dev) or set as env vars on the host (they are baked in at build time).
# Firebase console -> Project settings -> Your apps -> Web app. These values are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
